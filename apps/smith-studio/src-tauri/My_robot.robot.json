{
  "name": "My robot",
  "version": "1.0",
  "steps": [
    {
      "action": "windows.process",
      "params": {
        "action": "start",
        "command": "notepad.exe"
      },
      "outputs": {
        "pid": "notepad",
        "status": "notepad_status"
      }
    },
    {
      "action": "windows.click",
      "params": {
        "name": "Файл"
      }
    }
  ]
}